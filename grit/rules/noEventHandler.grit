language js

// prelude:start: generated from grit/prelude.grit by `bun run sync:prelude`; do not edit here
// Import resolution makes checks 15-100x slower, so renamed hooks require the deep preset.
pattern effect_hook() {
  or {
    `useEffect`,
    `React.useEffect`,
    `useDeepCompareEffect`,
    `useCustomCompareEffect`,
    `useShallowEffect`
  }
}

// JsImport handles multi-specifier imports on Biome 2.4.5; until nodes are tested before their children are skipped.
pattern mount_hook() {
  $hook where {
    $hook <: or { `useMount`, `useEffectOnce`, `useMountEffect` },
    $program <: not contains or {
      and {
        JsImport(),
        contains $hook,
        not contains or { `"react-use"`, `'react-use'`, `"ahooks"`, `'ahooks'`, `"@react-hookz/web"`, `'@react-hookz/web'`, `"primereact/hooks"`, `'primereact/hooks'` }
      },
      `function $hook($_) { $_ }`,
      `const $hook = $_`
    } until or { JsFunctionDeclaration(), JsVariableDeclarator(), JsExpressionStatement() }
  }
}

pattern layout_hook() {
  or {
    `useLayoutEffect`,
    `React.useLayoutEffect`,
    `useInsertionEffect`,
    `React.useInsertionEffect`
  }
}

pattern effect_event_hook() {
  or {
    `useEffectEvent`,
    `React.useEffectEvent`
  }
}

pattern function_node() {
  or {
    JsArrowFunctionExpression(),
    JsFunctionExpression(),
    JsFunctionDeclaration(),
    JsMethodObjectMember()
  }
}

pattern sync_callback($body) {
  and { not `async () => $_`,
  not `async function () { $_ }`,
  or {
    `() => $body`,
    `function () { $body }`
  } }
}

pattern state_declaration($state, $setter, $init) {
  or {
    `const [$state, $setter] = useState($init)`,
    `const [$state, $setter] = useState<$_>($init)`,
    `const [$state, $setter] = React.useState($init)`,
    `const [$state, $setter] = React.useState<$_>($init)`
  }
}

// GritQL has no lookup cache; component-scoped searches avoid repeated file-wide walks.
pattern state_setter($scope, $state, $setter) {
  $setter where {
    $setter <: r"[A-Za-z_$][A-Za-z0-9_$]*",
    $scope <: contains `const [$state, $setter] = $init` where {
      $init <: or {
        `useState($_)`,
        `useState<$_>($_)`,
        `React.useState($_)`,
        `React.useState<$_>($_)`
      }
    } until function_node()
  }
}

// Setter references in handlers or passed to children indicate editable state, not derived values.
pattern written_outside_effects($setter) {
  contains $setter as $use where {
    // Biome 2.4.5 rejects `$_` arguments in custom pattern calls.
    $use <: not within state_declaration($unusedState, $setter, $unusedInit),
    $use <: not within `$hook($_, $_)` where {
      $hook <: or {
        effect_hook(),
        layout_hook()
      }
    },
    $use <: not within `$hook($_)` where {
      $hook <: or {
        effect_hook(),
        layout_hook(),
        mount_hook()
      }
    }
  }
}

// Parameter defaults such as `disabled = false` must not make literals look like prop references.
pattern binding_name() {
  and { r"[A-Za-z_$][A-Za-z0-9_$]*",
  not r"(?:true|false|null|undefined|this)" }
}

// Tracing follows one hop through component/effect locals, excluding other nested functions.
pattern state_reference($scope, $local, $ref) {
  $ref where {
    $ref <: binding_name(),
    or {
      $scope <: contains or {
        `const [$ref, $_] = $init`,
        `const [$ref] = $init`
      } where {
        $init <: or {
          `useState($_)`,
          `useState<$_>($_)`,
          `React.useState($_)`,
          `React.useState<$_>($_)`
        }
      } until function_node(),
      and {
        or {
          $local <: contains or {
            `const $ref = $value`,
            `function $ref() { $value }`
          } until function_node(),
          $scope <: contains or {
            `const $ref = $value`,
            `function $ref() { $value }`
          } until function_node()
        },
        $value <: contains $source where {
          $source <: binding_name(),
          $scope <: contains or {
            `const [$source, $_] = $sourceInit`,
            `const [$source] = $sourceInit`
          } where {
            $sourceInit <: or {
              `useState($_)`,
              `useState<$_>($_)`,
              `React.useState($_)`,
              `React.useState<$_>($_)`
            }
          } until function_node()
        }
      }
    }
  }
}

// Parent callback checks skip one-hop tracing to keep per-call lookups cheap.
pattern prop_or_context($scope, $params, $ref) {
  $ref where {
    $ref <: binding_name(),
    or {
      $params <: contains $ref,
      $scope <: contains `const $binding = $context` where {
        $context <: or {
          `useContext($_)`,
          `React.useContext($_)`
        },
        $binding <: or {
          $ref,
          `{ $fields }` where { $fields <: contains $ref }
        }
      } until function_node()
    }
  }
}

// One-hop tracing follows props only; context values must be referenced directly.
pattern prop_reference($scope, $local, $params, $ref) {
  $ref where {
    $ref <: binding_name(),
    or {
      $params <: contains $ref,
      $scope <: contains `const $binding = $context` where {
        $context <: or {
          `useContext($_)`,
          `React.useContext($_)`
        },
        $binding <: or {
          $ref,
          `{ $fields }` where { $fields <: contains $ref }
        }
      } until function_node(),
      and {
        or {
          $local <: contains `const $ref = $value` until function_node(),
          $scope <: contains `const $ref = $value` until function_node()
        },
        $value <: contains $source where { $source <: binding_name(), $params <: contains $source }
      }
    }
  }
}

// Bare `return;` exits early and must not count as cleanup.
pattern cleanup_return() { `return $value` where { $value <: r"[\s\S]+" } }

// DOM nodes and layout exist only after commit, so effects that read them can't move into render.
pattern reads_dom() {
  contains or {
    `$_.current`,
    `new ResizeObserver($_)`,
    `new IntersectionObserver($_)`,
    `new IntersectionObserver($_, $_)`,
    `new MutationObserver($_)`
  }
}

pattern enclosing_function($name, $params, $body) {
  or {
    `function $name($params) { $body }`,
    `const $name = ($params) => $body`,
    `const $name = function ($params) { $body }`,
    `const $name = $_(($params) => $body)`,
    `const $name = $_(function ($params) { $body })`,
    `const $name = $_(function $_($params) { $body })`
  } where { $name <: r"[A-Z][A-Za-z0-9_]*|use[A-Z][A-Za-z0-9_]*" }
}
// prelude:end
or {
  `if ($test) { $then }`,
  `if ($test) return;`
} as $if where {
  $if <: not contains JsElseClause() until JsBlockStatement(),
  $if <: within `$hook($cb, $deps)` where { $hook <: effect_hook() },
  $cb <: sync_callback($body),
  $body <: contains $if until function_node(),
  $body <: not contains cleanup_return() until function_node(),
  $if <: within enclosing_function($unused1, $params, $component),
  // Setter calls and ref writes alone are state sync, which the state rules report with better advice.
  // An early return guards the rest of the effect body instead of a block.
  or {
    and {
      $if <: or {
        `if ($_) return;`,
        `if ($_) { return; }`
      },
      $body <: contains and { side_effect_call($component),
      not within $if } until function_node()
    },
    and {
      $if <: not or {
        `if ($_) return;`,
        `if ($_) { return; }`
      },
      $then <: contains side_effect_call($component) until function_node()
    }
  },
  or {
    and {
      $test <: contains state_reference($component, $body, $ref),
      $message = `Avoid using state and an effect as an event handler. Run the code that depends on "$ref" from the event handler that sets it instead. See https://react.dev/learn/you-might-not-need-an-effect#sharing-logic-between-event-handlers`
    },
    and {
      $test <: contains prop_reference($component, $body, $params, $ref),
      $message = `Avoid using props and an effect as an event handler. Move the code that depends on "$ref" to the parent's event handler instead. See https://react.dev/learn/you-might-not-need-an-effect#sharing-logic-between-event-handlers`
    }
  },
  register_diagnostic(span=$test, message=$message, severity="warn")
}

// A call that isn't a state setter. Calls inside a setter's arguments compute the next state, so they don't count.
pattern side_effect_call($component) {
  JsCallExpression() as $call where {
    $call <: not within `$setter($_)` where { $setter <: state_setter($component, $unusedState, $setter) },
    $call <: not `$setter($_)` where { $setter <: state_setter($component, $unusedState, $setter) }
  }
}
