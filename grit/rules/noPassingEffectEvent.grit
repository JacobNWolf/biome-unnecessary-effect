language js

// prelude:start: generated from grit/prelude.grit by `bun run sync:prelude`; do not edit here
// Renamed hooks need the deep preset: resolving imports per candidate call doubles each rule's cost, and Biome 2.4.5 can't match specifiers like `useEffect as $alias`.
pattern effect_hook() {
  or {
    `useEffect`,
    `React.useEffect`,
    `useDeepCompareEffect`,
    `useCustomCompareEffect`,
    `useShallowEffect`
  }
}

// JsImport handles multi-specifier imports on Biome 2.4.5; until nodes are tested before their children are skipped.
pattern mount_hook() {
  $hook where {
    $hook <: or {
      `useMount`,
      `useEffectOnce`,
      `useMountEffect`
    },
    $program <: not contains or {
      and { JsImport(),
      contains $hook,
      not contains or {
        `"react-use"`,
        `'react-use'`,
        `"ahooks"`,
        `'ahooks'`,
        `"@react-hookz/web"`,
        `'@react-hookz/web'`,
        `"primereact/hooks"`,
        `'primereact/hooks'`
      } },
      `function $hook($_) { $_ }`,
      `const $hook = $_`
    } until or {
      JsFunctionDeclaration(),
      JsVariableDeclarator(),
      JsExpressionStatement()
    }
  }
}

pattern layout_hook() {
  or {
    `useLayoutEffect`,
    `React.useLayoutEffect`,
    `useInsertionEffect`,
    `React.useInsertionEffect`
  }
}

pattern effect_event_hook() {
  or {
    `useEffectEvent`,
    `React.useEffectEvent`
  }
}

pattern function_node() {
  or {
    JsArrowFunctionExpression(),
    JsFunctionExpression(),
    JsFunctionDeclaration(),
    JsMethodObjectMember()
  }
}

// Checks AST ancestry rather than `contains $node`, which compares by text and re-reports nested duplicates.
pattern direct_in_body($body) {
  $node where { $node <: within $body, $node <: not within function_node() as $inner where { $inner <: within $body } }
}

// Component-local declarations cannot occur inside expressions or another function.
pattern declaration_boundary() {
  or {
    function_node(),
    JsVariableDeclarator(),
    JsExpressionStatement(),
    JsReturnStatement()
  }
}

pattern sync_callback($body) {
  and { not `async () => $_`,
  not `async function () { $_ }`,
  or {
    `() => $body`,
    `function () { $body }`
  } }
}

pattern use_state_call($init) {
  or {
    `useState($init)`,
    `useState<$_>($init)`,
    `React.useState($init)`,
    `React.useState<$_>($init)`,
    `useState($init) as $_`,
    `useState<$_>($init) as $_`,
    `React.useState($init) as $_`,
    `React.useState<$_>($init) as $_`
  }
}

pattern state_declaration($state, $setter, $init) {
  or {
    `const [$state, $setter] = $call`,
    `const [$state = $_, $setter] = $call`,
    // Value-less state has no name, so messages name the setter, as upstream does.
    `const [, $setter] = $call` where { $setter <: $state }
  } where { $call <: use_state_call($init) }
}

// GritQL has no lookup cache; component-scoped searches avoid repeated file-wide walks.
pattern state_setter($scope, $state, $setter, $original) {
  $setter where {
    $setter <: r"[A-Za-z_$][A-Za-z0-9_$]*",
    $scope <: contains or {
      state_declaration($state, $setter, $unusedInit) where { $original = $setter },
      // One hop: a let alias may be reassigned.
      `const $setter = $original` where {
        $scope <: contains state_declaration($state, $original, $aliasInit) until declaration_boundary()
      }
    } until declaration_boundary()
  }
}

// Setter references in handlers or passed to children indicate editable state, not derived values.
pattern written_outside_effects($target, $alias) {
  contains $target as $use where {
    // Biome 2.4.5 rejects `$_` arguments in custom pattern calls.
    $use <: not within state_declaration($unusedState, $target, $unusedInit),
    $use <: not within `const $target = $_`,
    $use <: not within `const $alias = $target`,
    $use <: not within or {
      `$hook($_, $_)` where {
        $hook <: or {
          effect_hook(),
          layout_hook()
        }
      },
      // A fourth comparator argument selects an effect hook and is excluded upstream.
      `useCustomCompareEffect($_, $_, $_)`
    },
    $use <: not within `$hook($_)` where {
      $hook <: or {
        effect_hook(),
        layout_hook(),
        mount_hook(),
        effect_event_hook()
      }
    }
  }
}

// Parameter defaults such as `disabled = false` must not make literals look like prop references.
pattern binding_name() {
  and { r"[A-Za-z_$][A-Za-z0-9_$]*",
  not r"(?:true|false|null|undefined|this)" }
}

// Excludes property names (JsName); callees bind JsIdentifierExpression, references bind JsReferenceIdentifier, JSX components bind JsxReferenceIdentifier.
pattern identifier_reference() {
  and { or {
    JsReferenceIdentifier(),
    JsIdentifierExpression(),
    JsxReferenceIdentifier()
  },
  binding_name() }
}

// Controller hooks return external handles, not derived copies of state passed in options.
pattern controller_hook() {
  or {
    `useFetcher`,
    `useNavigate`,
    `useNavigation`,
    `useRevalidator`,
    `useSearchParams`,
    `useEditor`,
    `useForm`,
    `useQueryClient`
  }
}

pattern external_hook_call() {
  contains or {
    `$hook($...)`,
    `$hook<$_>($...)`,
    `$hook()`,
    `$hook<$_>()`
  } where { $hook <: controller_hook() } until or {
    JsCallArguments(),
    JsObjectExpression(),
    JsArrayExpression(),
    JsBinaryExpression(),
    JsLogicalExpression(),
    JsConditionalExpression(),
    function_node()
  }
}

// Tracing follows one hop through component/effect locals, excluding controller hooks and nested functions.
pattern reads_state($scope, $local, $source) {
  $value where {
    $scope <: contains or {
      `const [$source, $_] = $init`,
      `const [$source] = $init`,
      `const [$source = $_, $_] = $init`
    } where {
      $init <: use_state_call($unusedInit),
      $source <: binding_name(),
      or {
        $value <: or {
          and { identifier_reference(),
          $source },
          contains and { JsReferenceIdentifier(),
          $source }
        },
        $local <: contains or {
          `const $alias = $aliasValue`,
          `function $alias() { $aliasValue }`
        } where {
          $alias <: binding_name(),
          $aliasValue <: not external_hook_call(),
          $value <: or {
            and { identifier_reference(),
            $alias },
            contains and { JsReferenceIdentifier(),
            $alias }
          },
          $aliasValue <: contains and { JsReferenceIdentifier(),
          $source }
        } until declaration_boundary(),
        $scope <: contains or {
          `const $alias = $aliasValue`,
          `function $alias() { $aliasValue }`
        } where {
          $alias <: binding_name(),
          $aliasValue <: not external_hook_call(),
          $value <: or {
            and { identifier_reference(),
            $alias },
            contains and { JsReferenceIdentifier(),
            $alias }
          },
          $aliasValue <: contains and { JsReferenceIdentifier(),
          $source }
        } until declaration_boundary()
      }
    } until declaration_boundary()
  }
}

pattern state_reference($scope, $local, $ref) {
  $ref where { $ref <: identifier_reference(), $ref <: reads_state($scope, $local) }
}

pattern state_source_reference($scope, $local, $source) {
  $ref where { $ref <: identifier_reference(), $ref <: reads_state($scope, $local, $source) }
}

pattern state_reference_with_source($scope, $local, $ref, $source) {
  $ref where { $ref <: identifier_reference(), $ref <: reads_state($scope, $local, $source) }
}

pattern effect_only_state($scope, $body, $source) {
  $source where {
    $scope <: contains state_declaration($source, $flagSetter, $flagInit) where {
      $scope <: not written_outside_effects($flagSetter, $flagSetter),
      or {
        $body <: contains `$flagSetter($_)`,
        $scope <: contains `const $ee = $eeCall` where {
          $ee <: binding_name(),
          $ee <: invoked_in($body),
          $eeCall <: `$eeHook($eeCb)` where { $eeHook <: effect_event_hook(), $eeCb <: contains `$flagSetter($_)` }
        } until declaration_boundary(),
        and {
          $flagInit <: `false`,
          $scope <: contains `$flagSetter(true)`,
          $scope <: not contains `$flagSetter($flagArg)` where { $flagArg <: not `true` }
        }
      }
    } until declaration_boundary()
  }
}

pattern prop_expression($params) {
  or {
    `$object.$_`,
    JsStaticMemberExpression(object=$object),
    $object
  } where {
    $object <: binding_name(),
    $params <: contains and { JsIdentifierBinding(),
    $object } until JsInitializerClause()
  }
}

pattern prop_or_context($scope, $params, $ref) {
  $ref where {
    $ref <: identifier_reference(),
    or {
      $params <: contains and { JsIdentifierBinding(),
      $ref } until JsInitializerClause(),
      $scope <: contains `const [$ref] = [$value]` where {
        $value <: prop_expression($params)
      } until declaration_boundary(),
      $scope <: contains `const $binding = $value` where {
        $binding <: or {
          $ref,
          and { JsObjectBindingPattern(),
          contains and { JsIdentifierBinding(),
          $ref } until or {
            JsInitializerClause(),
            JsComputedMemberName()
          } }
        },
        $value <: or {
          `useContext($_)`,
          `React.useContext($_)`,
          prop_expression($params),
          and { function_node(),
          contains `$prop($_)` where { $prop <: prop_expression($params) } }
        }
      } until declaration_boundary()
    }
  }
}

pattern parent_callback($scope, $params) {
  or {
    prop_or_context($scope, $params, $unusedRef),
    prop_expression($params),
    `$asserted!` where {
      $asserted <: or {
        prop_or_context($scope, $params, $unusedAsserted),
        prop_expression($params)
      }
    },
    `($object as $_).$_` where { $object <: prop_expression($params) }
  }
}

pattern custom_context_reference($scope, $ref) {
  $ref where {
    $ref <: identifier_reference(),
    $scope <: contains `const $binding = $context` where {
      $context <: or {
        `$ctxHook($...)`,
        `$ctxHook<$_>($...)`,
        `$ctxHook()`,
        `$ctxHook<$_>()`
      } where { $ctxHook <: r"^use[A-Z][A-Za-z0-9_]*Context$" },
      $binding <: or {
        $ref,
        and { JsObjectBindingPattern(),
        contains and { JsIdentifierBinding(),
        $ref } until or {
          JsInitializerClause(),
          JsComputedMemberName()
        } }
      }
    } until declaration_boundary()
  }
}

// One-hop tracing follows props only; context values must be referenced directly.
pattern prop_reference($scope, $local, $params, $ref) {
  $ref where {
    $ref <: identifier_reference(),
    or {
      $params <: contains and { JsIdentifierBinding(),
      $ref } until JsInitializerClause(),
      $scope <: contains `const $binding = $context` where {
        $context <: or {
          `useContext($_)`,
          `React.useContext($_)`
        },
        $binding <: or {
          $ref,
          and { JsObjectBindingPattern(),
          contains and { JsIdentifierBinding(),
          $ref } until or {
            JsInitializerClause(),
            JsComputedMemberName()
          } }
        }
      } until declaration_boundary(),
      and {
        or {
          $local <: contains or {
            `const $ref = $value`,
            `const [$ref] = [$value]` where { $value <: prop_expression($params) },
            `const $binding = $value` where {
              $binding <: and { JsArrayBindingPattern(),
              contains and { JsIdentifierBinding(),
              $ref } until JsInitializerClause() },
              $value <: not or {
                use_state_call($unusedLocalInit),
                JsArrayExpression()
              }
            },
            `const $binding = $value` where {
              $binding <: and { JsObjectBindingPattern(),
              contains and { JsIdentifierBinding(),
              $ref } until or {
                JsInitializerClause(),
                JsComputedMemberName()
              } },
              $value <: not or {
                use_state_call($unusedLocalObjInit),
                external_hook_call(),
                JsObjectExpression()
              }
            }
          } until declaration_boundary(),
          $scope <: contains or {
            `const $ref = $value`,
            `const [$ref] = [$value]` where { $value <: prop_expression($params) },
            `const $binding = $value` where {
              $binding <: and { JsArrayBindingPattern(),
              contains and { JsIdentifierBinding(),
              $ref } until JsInitializerClause() },
              $value <: not or {
                use_state_call($unusedScopeInit),
                JsArrayExpression()
              }
            },
            `const $binding = $value` where {
              $binding <: and { JsObjectBindingPattern(),
              contains and { JsIdentifierBinding(),
              $ref } until or {
                JsInitializerClause(),
                JsComputedMemberName()
              } },
              $value <: not or {
                use_state_call($unusedScopeObjInit),
                external_hook_call(),
                JsObjectExpression()
              }
            }
          } until declaration_boundary()
        },
        $value <: contains $source where {
          $source <: identifier_reference(),
          $params <: contains and { JsIdentifierBinding(),
          $source } until JsInitializerClause()
        }
      }
    }
  }
}

// Bare `return;` exits early and must not count as cleanup.
pattern cleanup_return() { `return $value` where { $value <: r"[\s\S]+" } }

pattern browser_global_binding($global, $reference) {
  and { JsIdentifierBinding(),
  $global } as $binding where {
    // Biome 2.4.5 cannot compile initializer field matchers on for-in/of nodes.
    $binding <: not within or {
      JsVariableDeclaration(),
      JsForVariableDeclaration()
    } as $declaration where {
      $declaration <: r"^(?:const|let)\b[\s\S]*",
      $declaration <: within or {
        JsForStatement(),
        JsForInStatement(),
        JsForOfStatement()
      } as $loop where { $reference <: not within $loop }
    }
  }
}

// Browser state and DOM nodes are external to React's render.
pattern browser_global() {
  // Binding matches rebind $global; keep the use site for loop-scope checks.
  $global as $reference where {
    $global <: r"^(?:window|document|localStorage|sessionStorage|navigator|requestAnimationFrame|cancelAnimationFrame)$",
    $program <: not contains browser_global_binding($global, $reference) until or {
      function_node(),
      JsBlockStatement()
    },
    $global <: not within or {
      `($params) => $scope`,
      `function $_($params) { $scope }`,
      `function ($params) { $scope }`
    } where {
      or {
        $params <: contains and { JsIdentifierBinding(),
        $global } until JsInitializerClause(),
        $scope <: contains browser_global_binding($global, $reference) until or {
          function_node(),
          JsBlockStatement()
        }
      }
    },
    $global <: not within `{ $scope }` where {
      $scope <: contains browser_global_binding($global, $reference) until or {
        function_node(),
        JsBlockStatement()
      }
    }
  }
}

pattern syncs_with_browser() {
  contains or {
    `$_.current`,
    `$_.current = $_`,
    `new ResizeObserver($_)`,
    `new IntersectionObserver($_)`,
    `new IntersectionObserver($_, $_)`,
    `new MutationObserver($_)`,
    // Matches both `.` and `?.`; Biome GritQL cannot compile `$browser?.$_`.
    JsStaticMemberExpression(object=$browser) where { $browser <: browser_global() },
    `$browser.$_ = $_` where { $browser <: browser_global() },
    `$browser($_)` where { $browser <: r"requestAnimationFrame|cancelAnimationFrame", $browser <: browser_global() },
    `$_.scrollIntoView()`,
    `$_.scrollIntoView($_)`,
    `$_.scrollTo($_)`,
    `$_.scrollTo($_, $_)`,
    `$_.scrollToIndex($...)`,
    `$_.scrollToOffset($...)`,
    `$_.scrollBy($...)`,
    `$_.focus()`,
    `$_.focus($_)`
  }
}

pattern reads_dom() {
  contains or {
    `$_.current`,
    `$_.current = $_`,
    `new ResizeObserver($_)`,
    `new IntersectionObserver($_)`,
    `new IntersectionObserver($_, $_)`,
    `new MutationObserver($_)`
  }
}

// Snippet variants avoid JsCallExpression(callee = ...), which Biome 2.4.5 cannot compile.
pattern invoked_in($body) {
  $fn where {
    $body <: contains or {
      `$fn($...)`,
      `$fn()`,
      `$fn?.($...)`,
      `$fn?.()`,
      `$fn!($...)`,
      `$fn!()`
    }
  }
}

pattern async_or_fetch_effect() {
  contains or {
    `await $_`,
    `$_.then($...)`,
    `fetch($...)`,
    `axios($...)`,
    `axios.$_($...)`,
    `ky($...)`,
    `ky.$_($...)`
  }
}

// `.test()` on a `g`/`y` regex advances its shared `lastIndex`; only regexes without those flags or freshly built ones are safe.
pattern stateless_regex_literal() {
  and { JsRegexLiteralExpression(),
  not r"^[\s\S]*/[a-z]*[gy][a-z]*$" }
}

pattern stateless_regex_const($re) {
  or {
    `const $re = $lit`,
    `const $re: $_ = $lit`
  } where { $lit <: stateless_regex_literal() }
}

pattern stateless_regex() {
  or {
    stateless_regex_literal(),
    `new RegExp($...)`,
    // Binding matches rebind $re; keep the use site for scope and shadowing checks.
    // Match `$re` before `JsIdentifierBinding()` and skip initializers/expressions/returns so repeated `.test()` calls stay fast.
    $re as $reUse where {
      $re <: identifier_reference(),
      $reUse <: not within function_node() as $fn where {
        $fn <: contains and { $re,
        JsIdentifierBinding() } as $shadowBinding where {
          $shadowBinding <: not within stateless_regex_const($re)
        } until or {
          JsInitializerClause(),
          JsExpressionStatement(),
          JsReturnStatement()
        }
      },
      or {
        and {
          $program <: contains and { $re,
          JsIdentifierBinding() } as $topReBinding where {
            $topReBinding <: within stateless_regex_const($re)
          } until or {
            function_node(),
            JsBlockStatement(),
            JsExpressionStatement()
          },
          $program <: not contains and { $re,
          JsIdentifierBinding() } as $topShadowBinding where {
            $topShadowBinding <: not within stateless_regex_const($re)
          } until or {
            function_node(),
            JsBlockStatement(),
            JsExpressionStatement()
          }
        },
        $reUse <: within or {
          JsFunctionBody(),
          JsBlockStatement()
        } as $reScope where {
          $reScope <: contains and { $re,
          JsIdentifierBinding() } as $localReBinding where {
            $localReBinding <: within stateless_regex_const($re),
            $localReBinding <: not within or {
              function_node(),
              JsBlockStatement()
            } as $innerReScope where { $innerReScope <: not $reScope, $innerReScope <: within $reScope }
          } until or {
            function_node(),
            JsInitializerClause(),
            JsExpressionStatement(),
            JsReturnStatement()
          }
        }
      }
    }
  }
}

// Pure read/transform methods and constructors that are not external side effects.
// Standalone expression statements stay side effects so calls like `router.replace()` or `api.get()` are not skipped.
// Snippet and regex forms avoid JsCallExpression(callee = ...) and JsStaticMemberExpression(member = ...), which Biome 2.4.5 cannot compile.
pattern pure_call() {
  or {
    `$_.$method($...)` where {
      $method <: r"^(?:find|findIndex|filter|map|flatMap|reduce|reduceRight|some|every|includes|indexOf|lastIndexOf|slice|concat|join|split|trim|trimStart|trimEnd|toLowerCase|toUpperCase|startsWith|endsWith|replace|replaceAll|match|has|get|keys|values|entries|toString|valueOf|at|flat|toFixed|charAt|substring|padStart|padEnd|toSorted|toReversed|toSpliced|with)$"
    },
    `$re.test($...)` where { $re <: stateless_regex() },
    or {
      `$callee($...)`,
      `$callee?.($...)`
    } where {
      $callee <: r"^[A-Za-z0-9_$.?\[\]\s]+\?\.(?:find|findIndex|filter|map|flatMap|reduce|reduceRight|some|every|includes|indexOf|lastIndexOf|slice|concat|join|split|trim|trimStart|trimEnd|toLowerCase|toUpperCase|startsWith|endsWith|replace|replaceAll|match|has|get|keys|values|entries|toString|valueOf|at|flat|toFixed|charAt|substring|padStart|padEnd|toSorted|toReversed|toSpliced|with)$"
    },
    or {
      `$callee($...)`,
      `$callee?.($...)`
    } where {
      $callee <: r"^[A-Za-z0-9_$.?\[\]\s]+\?\.test$",
      $callee <: JsStaticMemberExpression(object=$re),
      $re <: stateless_regex()
    },
    `$fn($...)` where {
      $fn <: r"^(?:Boolean|String|Number|BigInt|Array|Set|Map|parseInt|parseFloat|isNaN|isFinite|isEqual|encodeURIComponent|decodeURIComponent)$"
    },
    `Object.$method($...)` where {
      $method <: r"^(?:keys|values|entries|fromEntries|is|hasOwn|getOwnPropertyNames|getOwnPropertyDescriptor|getPrototypeOf)$"
    },
    `$ns.$_($...)` where { $ns <: r"^(?:Array|Math|Number|JSON|Date)$" }
  } as $pureCall where {
    $pureCall <: not within JsExpressionStatement() as $stmt where {
      $stmt <: or {
        `$pureCall;`,
        `$pureCall`
      }
    }
  }
}

// Initializers that always allocate a new array; `.get()`/`.find()` and similar can return a stored one.
pattern fresh_array() {
  or {
    JsArrayExpression(),
    `$_.$method($...)` where {
      $method <: r"^(?:filter|map|flatMap|slice|concat|split|flat|toSorted|toReversed|toSpliced|with)$"
    },
    or {
      `$callee($...)`,
      `$callee?.($...)`
    } where {
      $callee <: r"^[A-Za-z0-9_$.?\[\]\s]+\?\.(?:filter|map|flatMap|slice|concat|split|flat|toSorted|toReversed|toSpliced|with)$"
    },
    `Array.$method($...)` where { $method <: r"^(?:from|of)$" },
    `Object.$method($...)` where { $method <: r"^(?:keys|values|entries|getOwnPropertyNames)$" },
    `Array($...)`,
    `new Array($...)`
  }
}

// `.push()` on a local array initialized inside the same function block (not component- or module-level mutation).
pattern local_array_push() {
  `$localArr.push($...)` as $pushCall where {
    $localArr <: identifier_reference(),
    $pushCall <: within or {
      JsFunctionBody(),
      JsBlockStatement()
    } as $block where {
      $pushCall <: direct_in_body($block),
      $pushCall <: not within or {
        JsBlockStatement(),
        JsCatchClause(),
        JsForInStatement(),
        JsForOfStatement(),
        JsForStatement()
      } as $shadowBlock where {
        $shadowBlock <: not $block,
        $shadowBlock <: within $block,
        $shadowBlock <: contains and { JsIdentifierBinding(),
        $localArr }
      },
      or {
        $block <: contains or {
          `const $localArr = $arrInit`,
          `const $localArr: $_ = $arrInit`
        } as $constDecl where {
          $arrInit <: fresh_array(),
          $constDecl <: not within JsBlockStatement() as $innerConstBlock where {
            $innerConstBlock <: not $block,
            $innerConstBlock <: within $block
          }
        } until function_node(),
        and {
          $block <: contains or {
            `let $localArr = $arrInit`,
            `let $localArr: $_ = $arrInit`
          } as $letDecl where {
            $arrInit <: fresh_array(),
            $letDecl <: not within JsBlockStatement() as $innerLetBlock where {
              $innerLetBlock <: not $block,
              $innerLetBlock <: within $block
            }
          } until function_node(),
          // Node form also covers `??=`/`||=`/`+=` and destructuring targets (`[a] = ...`, `({ a } = ...)`).
          $block <: not contains JsAssignmentExpression(left=$lhs) where {
            $lhs <: or {
              $localArr,
              contains and { JsIdentifierAssignment(),
              $localArr }
            }
          }
        }
      }
    }
  }
}

// Same-component helper whose body only calls state setters, pure helpers, or .push() on a helper-local array.
pattern state_only_helper($component) {
  or {
    `$helper($...)`,
    `$helper?.($...)`
  } where {
    $helper <: identifier_reference(),
    $component <: contains or {
      `const $helper = ($...) => $hBody`,
      `function $helper($...) { $hBody }`
    } where {
      $hBody <: not syncs_with_browser(),
      $hBody <: contains `$s($_)` where { $s <: state_setter($component, $uState, $s) },
      $hBody <: not contains JsCallExpression() as $innerCall where {
        $innerCall <: not pure_call(),
        $innerCall <: not local_array_push(),
        $innerCall <: not `$s2($_)` where { $s2 <: state_setter($component, $u2, $s2) },
        $innerCall <: not within `$s2($_)` where { $s2 <: state_setter($component, $u2, $s2) }
      }
    } until declaration_boundary()
  }
}

// Snippet variants avoid JsCallExpression(callee = ...) and JsStaticMemberExpression(member = ...), which Biome 2.4.5 rejects.
pattern async_or_accumulating_write($component, $target, $state) {
  contains `$target($otherArg)` as $otherCall where {
    or {
      $otherCall <: within or {
        `$_.then($...)`,
        `$_.catch($...)`,
        `$_.finally($...)`
      },
      $otherCall <: within function_node() as $asyncFn where {
        $asyncFn <: r"^async\b[\s\S]*",
        $asyncFn <: contains `await $_`
      },
      $otherCall <: within or {
        `setTimeout($...)`,
        `setInterval($...)`,
        `window.setTimeout($...)`,
        `window.setInterval($...)`
      },
      $otherArg <: or {
        and { identifier_reference(),
        $state },
        contains and { JsReferenceIdentifier(),
        $state }
      },
      $otherArg <: contains function_node() until or {
        JsCallExpression(),
        JsNewExpression(),
        JsObjectExpression(),
        JsArrayExpression()
      }
    }
  }
}

pattern hook_setter($component, $setter) {
  $setter as $setterUse where {
    $setter <: identifier_reference(),
    $setter <: r"set[A-Z][A-Za-z0-9_$]*",
    $component <: contains `const $binding = $hookCall` as $hookDeclaration where {
      $hookCall <: or {
        `$hook($...)`,
        `$hook<$_>($...)`,
        `$hook()`,
        `$hook<$_>()`
      } where { $hook <: r"^use[A-Z][A-Za-z0-9_]*$" },
      $binding <: and { or {
        JsArrayBindingPattern(),
        JsObjectBindingPattern()
      },
      contains and { JsIdentifierBinding(),
      $setter } until or {
        JsInitializerClause(),
        JsComputedMemberName()
      } }
    } until declaration_boundary(),
    $setterUse <: not within or {
      function_node(),
      JsBlockStatement(),
      JsSwitchStatement(),
      JsCatchClause(),
      JsForStatement(),
      JsForInStatement(),
      JsForOfStatement()
    } as $scope where {
      $scope <: within $component,
      $scope <: contains and { $setter,
      JsIdentifierBinding() } as $shadowBinding where {
        $shadowBinding <: not within $hookDeclaration,
        $shadowBinding <: not within or {
          function_node(),
          JsBlockStatement(),
          JsSwitchStatement(),
          JsCatchClause(),
          JsForStatement(),
          JsForInStatement(),
          JsForOfStatement()
        } as $innerScope where {
          $innerScope <: not $scope,
          $innerScope <: within $scope,
          $innerScope <: not `function $setter($...) { $... }`,
          or {
            $innerScope <: function_node(),
            $shadowBinding <: not within and { or {
              JsVariableDeclaration(),
              JsForVariableDeclaration()
            },
            r"(?s)var\s.*" }
          }
        }
      } until or {
        JsInitializerClause(),
        JsComputedMemberName(),
        JsExpressionStatement(),
        JsReturnStatement()
      }
    }
  }
}

pattern custom_state_hook_declaration($state, $setter) {
  or {
    `const [$state, $setter] = $call`,
    `const [$state = $_, $setter] = $call`
  } where {
    $state <: binding_name(),
    $setter <: r"set[A-Z][A-Za-z0-9_$]*",
    $call <: or {
      `$hook($...)`,
      `$hook<$_>($...)`,
      `$hook()`,
      `$hook<$_>()`
    } where { $hook <: r"^use[A-Z][A-Za-z0-9_]*State$" }
  }
}

// Calls inside setter arguments compute the next value rather than synchronize an external system.
pattern side_effect_call($component) {
  JsCallExpression() as $call where {
    $call <: not pure_call(),
    $call <: not local_array_push(),
    $call <: not `$setter($_)` where { $setter <: state_setter($component, $unusedState, $setter) },
    $call <: not within `$setter($_)` where { $setter <: state_setter($component, $unusedState, $setter) },
    $call <: not state_only_helper($component)
  }
}

pattern enclosing_function($name, $params, $body) {
  and { or {
    JsFunctionDeclaration(),
    JsFunctionExpression(),
    JsVariableDeclaration()
  },
  or {
    `function $name($params) { $body }`,
    `const $name = ($params) => $body`,
    `const $name = function ($params) { $body }`,
    `const $name = $_(($params) => $body)`,
    `const $name = $_(function ($params) { $body })`,
    `const $name = $_(function $_($params) { $body })`,
    `const $name = (($params) => $body) satisfies $_`,
    `const $name = (($params) => $body) as $_`,
    `const $name = $_(($params) => $body) as $_`,
    `const $name = $_(function ($params) { $body }) as $_`
  } } where { $name <: r"[A-Z][A-Za-z0-9_]*|use[A-Z][A-Za-z0-9_]*" }
}
// prelude:end

// Matches callback-named props (`onChange`, `props.onChange`) rather than emitters like `connection.on` or `subscribe`.
pattern callback_prop($params) {
  or {
    $prop where {
      $prop <: identifier_reference(),
      $prop <: r"^on[A-Z][A-Za-z0-9_$]*$",
      $params <: contains and { JsIdentifierBinding(),
      $prop } until JsInitializerClause()
    },
    `$obj.$prop` where {
      $obj <: binding_name(),
      $prop <: r"^on[A-Z][A-Za-z0-9_$]*$",
      $params <: contains and { JsIdentifierBinding(),
      $obj } until JsInitializerClause()
    }
  }
}

pattern callback_prop_ref($scope, $params) {
  or {
    callback_prop($params),
    $alias where {
      $alias <: identifier_reference(),
      $scope <: contains `const $alias = $src` where { $src <: callback_prop($params) } until declaration_boundary()
    }
  }
}

// Rooted on each Effect Event declaration, so this reports the first misuse of each Effect Event.
or {
  `const $event = useEffectEvent($_)`,
  `const $event = React.useEffectEvent($_)`
} as $declaration where {
  $declaration <: within enclosing_function($unused1, $params, $component),
  $component <: contains or {
    JsxExpressionAttributeValue() as $use where { $use <: contains $event until function_node() },
    or {
      `$fn($args)`,
      `$fn?.($args)`
    } as $use where {
      $fn <: not or {
        effect_hook(),
        mount_hook(),
        layout_hook(),
        effect_event_hook()
      },
      $args <: contains $event until function_node(),
      // Handing an Effect Event to a timer or an emitter from inside an effect is allowed,
      // unless it escapes via a parent callback prop.
      or {
        $fn <: callback_prop_ref($component, $params),
        and {
          $use <: not within `$hook($_, $_)` where {
            $hook <: or {
              effect_hook(),
              layout_hook()
            }
          },
          $use <: not within `$hook($_)` where { $hook <: mount_hook() }
        }
      }
    }
  },
  register_diagnostic(span=$use, message=`Don't pass the Effect Event "$event" to components or hooks. Declare it with useEffectEvent next to the effect that calls it. See https://react.dev/reference/react/useEffectEvent`, severity="warn")
}
