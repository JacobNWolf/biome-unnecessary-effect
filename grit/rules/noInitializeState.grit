language js

// prelude:start: generated from grit/prelude.grit by `bun run sync:prelude`; do not edit here
// Import resolution makes checks 15-100x slower, so renamed hooks require the deep preset.
pattern effect_hook() {
  or {
    `useEffect`,
    `React.useEffect`,
    `useDeepCompareEffect`,
    `useCustomCompareEffect`,
    `useShallowEffect`
  }
}

pattern mount_hook() {
  or {
    `useMount`,
    `useEffectOnce`,
    `useMountEffect`
  }
}

pattern layout_hook() {
  or {
    `useLayoutEffect`,
    `React.useLayoutEffect`,
    `useInsertionEffect`,
    `React.useInsertionEffect`
  }
}

pattern effect_event_hook() {
  or {
    `useEffectEvent`,
    `React.useEffectEvent`
  }
}

pattern function_node() {
  or {
    JsArrowFunctionExpression(),
    JsFunctionExpression(),
    JsFunctionDeclaration(),
    JsMethodObjectMember()
  }
}

pattern sync_callback($body) {
  and { not `async () => $_`,
  not `async function () { $_ }`,
  or {
    `() => $body`,
    `function () { $body }`
  } }
}

pattern state_declaration($state, $setter, $init) {
  or {
    `const [$state, $setter] = useState($init)`,
    `const [$state, $setter] = useState<$_>($init)`,
    `const [$state, $setter] = React.useState($init)`,
    `const [$state, $setter] = React.useState<$_>($init)`
  }
}

// GritQL has no lookup cache; component-scoped searches avoid repeated file-wide walks.
pattern state_setter($scope, $state, $setter) {
  $setter where {
    $setter <: r"[A-Za-z_$][A-Za-z0-9_$]*",
    $scope <: contains `const [$state, $setter] = $init` where {
      $init <: or {
        `useState($_)`,
        `useState<$_>($_)`,
        `React.useState($_)`,
        `React.useState<$_>($_)`
      }
    } until function_node()
  }
}

// Parameter defaults such as `disabled = false` must not make literals look like prop references.
pattern binding_name() {
  and { r"[A-Za-z_$][A-Za-z0-9_$]*",
  not r"(?:true|false|null|undefined|this)" }
}

// Tracing follows one hop through component/effect locals, excluding other nested functions.
pattern state_reference($scope, $local, $ref) {
  $ref where {
    $ref <: binding_name(),
    or {
      $scope <: contains or {
        `const [$ref, $_] = $init`,
        `const [$ref] = $init`
      } where {
        $init <: or {
          `useState($_)`,
          `useState<$_>($_)`,
          `React.useState($_)`,
          `React.useState<$_>($_)`
        }
      } until function_node(),
      and {
        or {
          $local <: contains or {
            `const $ref = $value`,
            `function $ref() { $value }`
          } until function_node(),
          $scope <: contains or {
            `const $ref = $value`,
            `function $ref() { $value }`
          } until function_node()
        },
        $value <: contains $source where {
          $source <: binding_name(),
          $scope <: contains or {
            `const [$source, $_] = $sourceInit`,
            `const [$source] = $sourceInit`
          } where {
            $sourceInit <: or {
              `useState($_)`,
              `useState<$_>($_)`,
              `React.useState($_)`,
              `React.useState<$_>($_)`
            }
          } until function_node()
        }
      }
    }
  }
}

// Parent callback checks skip one-hop tracing to keep per-call lookups cheap.
pattern prop_or_context($scope, $params, $ref) {
  $ref where {
    $ref <: binding_name(),
    or {
      $params <: contains $ref,
      $scope <: contains `const $binding = $context` where {
        $context <: or {
          `useContext($_)`,
          `React.useContext($_)`
        },
        $binding <: or {
          $ref,
          `{ $fields }` where { $fields <: contains $ref }
        }
      } until function_node()
    }
  }
}

// One-hop tracing follows props only; context values must be referenced directly.
pattern prop_reference($scope, $local, $params, $ref) {
  $ref where {
    $ref <: binding_name(),
    or {
      $params <: contains $ref,
      $scope <: contains `const $binding = $context` where {
        $context <: or {
          `useContext($_)`,
          `React.useContext($_)`
        },
        $binding <: or {
          $ref,
          `{ $fields }` where { $fields <: contains $ref }
        }
      } until function_node(),
      and {
        or {
          $local <: contains `const $ref = $value` until function_node(),
          $scope <: contains `const $ref = $value` until function_node()
        },
        $value <: contains $source where { $source <: binding_name(), $params <: contains $source }
      }
    }
  }
}

// Bare `return;` exits early and must not count as cleanup.
pattern cleanup_return() { `return $value` where { $value <: r"[\s\S]+" } }

// DOM nodes and layout exist only after commit, so effects that read them can't move into render.
pattern reads_dom() {
  contains or {
    `$_.current`,
    `new ResizeObserver($_)`,
    `new IntersectionObserver($_)`,
    `new IntersectionObserver($_, $_)`,
    `new MutationObserver($_)`
  }
}

pattern enclosing_function($name, $params, $body) {
  or {
    `function $name($params) { $body }`,
    `const $name = ($params) => $body`,
    `const $name = function ($params) { $body }`,
    `const $name = $_(($params) => $body)`,
    `const $name = $_(function ($params) { $body })`,
    `const $name = $_(function $_($params) { $body })`
  } where { $name <: r"[A-Z][A-Za-z0-9_]*|use[A-Z][A-Za-z0-9_]*" }
}
// prelude:end

`$setter($arg)` as $call where {
  $call <: within or {
    `$hook($cb, $deps)` where { $hook <: effect_hook() },
    `$hook($cb)` where { $hook <: mount_hook() }
  },
  $cb <: sync_callback($body),
  $body <: contains $call until function_node(),
  $body <: not reads_dom(),
  // An initial read next to a subscription is part of syncing with it.
  $body <: not contains cleanup_return() until function_node(),
  $call <: within enclosing_function($unused1, $params, $component),
  $setter <: state_setter($component, $state, $setter),
  // Setters are stable, so an effect whose only dependency is a setter runs once, like `[]`.
  or {
    $hook <: mount_hook(),
    $deps <: `[]`,
    and { $deps <: `[$only]`, $only <: state_setter($component, $unused2, $only) }
  },
  register_diagnostic(span=$call, message=`Avoid initializing state in an effect. Pass this value to the useState() that declares "$state" instead; for SSR hydration, prefer useSyncExternalStore. See https://tkdodo.eu/blog/avoiding-hydration-mismatches-with-use-sync-external-store`, severity="warn")
}
