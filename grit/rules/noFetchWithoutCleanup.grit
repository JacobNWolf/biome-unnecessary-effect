language js

// prelude:start: generated from grit/prelude.grit by `bun run sync:prelude`; do not edit here
// Renamed hooks need the deep preset: resolving imports per candidate call doubles each rule's cost, and Biome 2.4.5 can't match specifiers like `useEffect as $alias`.
pattern effect_hook() {
  or {
    `useEffect`,
    `React.useEffect`,
    `useDeepCompareEffect`,
    `useCustomCompareEffect`,
    `useShallowEffect`
  }
}

// JsImport handles multi-specifier imports on Biome 2.4.5; until nodes are tested before their children are skipped.
pattern mount_hook() {
  $hook where {
    $hook <: or {
      `useMount`,
      `useEffectOnce`,
      `useMountEffect`
    },
    $program <: not contains or {
      and { JsImport(),
      contains $hook,
      not contains or {
        `"react-use"`,
        `'react-use'`,
        `"ahooks"`,
        `'ahooks'`,
        `"@react-hookz/web"`,
        `'@react-hookz/web'`,
        `"primereact/hooks"`,
        `'primereact/hooks'`
      } },
      `function $hook($_) { $_ }`,
      `const $hook = $_`
    } until or {
      JsFunctionDeclaration(),
      JsVariableDeclarator(),
      JsExpressionStatement()
    }
  }
}

pattern layout_hook() {
  or {
    `useLayoutEffect`,
    `React.useLayoutEffect`,
    `useInsertionEffect`,
    `React.useInsertionEffect`
  }
}

pattern effect_event_hook() {
  or {
    `useEffectEvent`,
    `React.useEffectEvent`
  }
}

pattern function_node() {
  or {
    JsArrowFunctionExpression(),
    JsFunctionExpression(),
    JsFunctionDeclaration(),
    JsMethodObjectMember()
  }
}

// Component-local declarations cannot occur inside expressions or another function.
pattern declaration_boundary() {
  or {
    function_node(),
    JsVariableDeclarator(),
    JsExpressionStatement(),
    JsReturnStatement()
  }
}

pattern sync_callback($body) {
  and { not `async () => $_`,
  not `async function () { $_ }`,
  or {
    `() => $body`,
    `function () { $body }`
  } }
}

pattern use_state_call($init) {
  or {
    `useState($init)`,
    `useState<$_>($init)`,
    `React.useState($init)`,
    `React.useState<$_>($init)`,
    `useState($init) as $_`,
    `useState<$_>($init) as $_`,
    `React.useState($init) as $_`,
    `React.useState<$_>($init) as $_`
  }
}

pattern state_declaration($state, $setter, $init) {
  or {
    `const [$state, $setter] = $call`,
    `const [$state = $_, $setter] = $call`,
    // Value-less state has no name, so messages name the setter, as upstream does.
    `const [, $setter] = $call` where { $setter <: $state }
  } where { $call <: use_state_call($init) }
}

// GritQL has no lookup cache; component-scoped searches avoid repeated file-wide walks.
pattern state_setter($scope, $state, $setter, $original) {
  $setter where {
    $setter <: r"[A-Za-z_$][A-Za-z0-9_$]*",
    $scope <: contains or {
      state_declaration($state, $setter, $unusedInit) where { $original = $setter },
      // One hop: a let alias may be reassigned.
      `const $setter = $original` where {
        $scope <: contains state_declaration($state, $original, $aliasInit) until declaration_boundary()
      }
    } until declaration_boundary()
  }
}

// Setter references in handlers or passed to children indicate editable state, not derived values.
pattern written_outside_effects($target, $alias) {
  contains $target as $use where {
    // Biome 2.4.5 rejects `$_` arguments in custom pattern calls.
    $use <: not within state_declaration($unusedState, $target, $unusedInit),
    $use <: not within `const $target = $_`,
    $use <: not within `const $alias = $target`,
    $use <: not within `$hook($_, $_)` where {
      $hook <: or {
        effect_hook(),
        layout_hook()
      }
    },
    $use <: not within `$hook($_)` where {
      $hook <: or {
        effect_hook(),
        layout_hook(),
        mount_hook()
      }
    }
  }
}

// Parameter defaults such as `disabled = false` must not make literals look like prop references.
pattern binding_name() {
  and { r"[A-Za-z_$][A-Za-z0-9_$]*",
  not r"(?:true|false|null|undefined|this)" }
}

// Tracing follows one hop through component/effect locals, excluding other nested functions.
pattern reads_state($scope, $local) {
  $value where {
    $scope <: contains or {
      `const [$source, $_] = $init`,
      `const [$source] = $init`,
      `const [$source = $_, $_] = $init`
    } where {
      $init <: use_state_call($unusedInit),
      $source <: binding_name(),
      or {
        $value <: or {
          $source,
          contains $source
        },
        $local <: contains or {
          `const $alias = $aliasValue`,
          `function $alias() { $aliasValue }`
        } where {
          $alias <: binding_name(),
          $value <: or {
            $alias,
            contains $alias
          },
          $aliasValue <: contains $source
        } until declaration_boundary(),
        $scope <: contains or {
          `const $alias = $aliasValue`,
          `function $alias() { $aliasValue }`
        } where {
          $alias <: binding_name(),
          $value <: or {
            $alias,
            contains $alias
          },
          $aliasValue <: contains $source
        } until declaration_boundary()
      }
    } until declaration_boundary()
  }
}

pattern state_reference($scope, $local, $ref) {
  $ref where { $ref <: binding_name(), $ref <: reads_state($scope, $local) }
}

pattern prop_expression($params) {
  or {
    `$object.$_`,
    $object
  } where { $object <: binding_name(), $params <: contains $object }
}

pattern prop_or_context($scope, $params, $ref) {
  $ref where {
    $ref <: binding_name(),
    or {
      $params <: contains $ref,
      $scope <: contains `const $binding = $value` where {
        $binding <: or {
          $ref,
          and { JsObjectBindingPattern(),
          contains and { JsIdentifierBinding(),
          $ref } until or {
            JsInitializerClause(),
            JsComputedMemberName()
          } }
        },
        $value <: or {
          `useContext($_)`,
          `React.useContext($_)`,
          prop_expression($params),
          contains `$prop($_)` where { $prop <: prop_expression($params) }
        }
      } until declaration_boundary()
    }
  }
}

// One-hop tracing follows props only; context values must be referenced directly.
pattern prop_reference($scope, $local, $params, $ref) {
  $ref where {
    $ref <: binding_name(),
    or {
      $params <: contains $ref,
      $scope <: contains `const $binding = $context` where {
        $context <: or {
          `useContext($_)`,
          `React.useContext($_)`
        },
        $binding <: or {
          $ref,
          and { JsObjectBindingPattern(),
          contains and { JsIdentifierBinding(),
          $ref } until or {
            JsInitializerClause(),
            JsComputedMemberName()
          } }
        }
      } until declaration_boundary(),
      and {
        or {
          $local <: contains `const $ref = $value` until declaration_boundary(),
          $scope <: contains `const $ref = $value` until declaration_boundary()
        },
        $value <: contains $source where { $source <: binding_name(), $params <: contains $source }
      }
    }
  }
}

// Bare `return;` exits early and must not count as cleanup.
pattern cleanup_return() { `return $value` where { $value <: r"[\s\S]+" } }

// DOM nodes and layout exist only after commit, so effects that read them can't move into render.
pattern reads_dom() {
  contains or {
    `$_.current`,
    `new ResizeObserver($_)`,
    `new IntersectionObserver($_)`,
    `new IntersectionObserver($_, $_)`,
    `new MutationObserver($_)`
  }
}

pattern enclosing_function($name, $params, $body) {
  and { or {
    JsFunctionDeclaration(),
    JsFunctionExpression(),
    JsVariableDeclaration()
  },
  or {
    `function $name($params) { $body }`,
    `const $name = ($params) => $body`,
    `const $name = function ($params) { $body }`,
    `const $name = $_(($params) => $body)`,
    `const $name = $_(function ($params) { $body })`,
    `const $name = $_(function $_($params) { $body })`,
    `const $name = (($params) => $body) satisfies $_`,
    `const $name = (($params) => $body) as $_`,
    `const $name = $_(($params) => $body) as $_`,
    `const $name = $_(function ($params) { $body }) as $_`
  } } where { $name <: r"[A-Z][A-Za-z0-9_]*|use[A-Z][A-Za-z0-9_]*" }
}
// prelude:end
`$hook($cb, $deps)` where {
  $hook <: or {
    effect_hook(),
    layout_hook()
  },
  $cb <: sync_callback($body),
  $body <: contains or {
    `fetch($_)`,
    `axios($_)`,
    `axios.$_($_)`,
    `ky($_)`,
    `ky.$_($_)`
  } as $request,
  $body <: not contains cleanup_return() until function_node(),
  // One request per mount has no newer response to race it.
  $deps <: not `[]`,
  // A response that is never read can't overwrite anything.
  $body <: contains or {
    `await $request`,
    `$request.then($_)`,
    `$request.then($_, $_)`,
    `const $_ = $request`
  },
  register_diagnostic(span=$request, message="This request has no cleanup, so a slower, older response can overwrite a newer one. Return a cleanup that aborts the request or ignores its result, or use a data-fetching library. See https://react.dev/learn/you-might-not-need-an-effect#fetching-data", severity="warn")
}
