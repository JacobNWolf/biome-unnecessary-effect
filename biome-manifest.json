{
  "$schema": "./node_modules/@biomejs/biome/manifest_schema.json",
  "version": 1,
  "plugins": {
    "rules": [
      {
        "noAdjustStateOnPropChange": "./grit/rules/noAdjustStateOnPropChange.grit"
      },
      {
        "noChainStateUpdates": "./grit/rules/noChainStateUpdates.grit"
      },
      {
        "noDerivedState": "./grit/rules/noDerivedState.grit"
      },
      {
        "noEmptyEffect": "./grit/rules/noEmptyEffect.grit"
      },
      {
        "noEventHandler": "./grit/rules/noEventHandler.grit"
      },
      {
        "noExternalStoreSubscription": "./grit/rules/noExternalStoreSubscription.grit"
      },
      {
        "noFetchWithoutCleanup": "./grit/rules/noFetchWithoutCleanup.grit"
      },
      {
        "noInitializeState": "./grit/rules/noInitializeState.grit"
      },
      {
        "noPassDataToParent": "./grit/rules/noPassDataToParent.grit"
      },
      {
        "noPassLiveStateToParent": "./grit/rules/noPassLiveStateToParent.grit"
      },
      {
        "noResetAllStateOnPropChange": "./grit/rules/noResetAllStateOnPropChange.grit"
      }
    ],
    "presets": {
      "recommended": [
        "noAdjustStateOnPropChange",
        "noChainStateUpdates",
        "noDerivedState",
        "noEmptyEffect",
        "noEventHandler",
        "noExternalStoreSubscription",
        "noFetchWithoutCleanup",
        "noInitializeState",
        "noPassDataToParent",
        "noPassLiveStateToParent",
        "noResetAllStateOnPropChange"
      ]
    }
  }
}
