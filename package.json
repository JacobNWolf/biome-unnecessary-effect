{
  "name": "@jacobwolf/biome-unnecessary-effect",
  "version": "0.2.1",
  "description": "Biome plugin that flags unnecessary and misused React effects.",
  "keywords": [
    "biome",
    "biome-plugin",
    "gritql",
    "react",
    "react-hooks",
    "useeffect"
  ],
  "homepage": "https://github.com/JacobNWolf/biome-unnecessary-effect#readme",
  "bugs": {
    "url": "https://github.com/JacobNWolf/biome-unnecessary-effect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobNWolf/biome-unnecessary-effect.git"
  },
  "license": "Beerware",
  "author": "Jacob Wolf",
  "type": "module",
  "files": [
    "biome-manifest.json",
    "grit/rules",
    "scripts/init.js",
    "ts/rules",
    "ts/shared"
  ],
  "exports": {
    "biome": "./biome-manifest.json"
  },
  "bin": {
    "biome-unnecessary-effect": "scripts/init.js"
  },
  "scripts": {
    "test": "bun test",
    "eval": "bun scripts/eval.mts",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "sync:prelude": "node scripts/sync-prelude.js",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@biomejs/runtime": "2.6.6",
    "@types/bun": "1.4.4",
    "es-toolkit": "1.53.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.2.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
