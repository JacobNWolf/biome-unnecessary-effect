{
  "name": "@jacobwolf/biome-unnecessary-effect",
  "description": "Biome plugin that detects unnecessary and misused React effect hooks.",
  "version": "0.1.1",
  "license": "Beerware",
  "author": "Jacob Wolf",
  "homepage": "https://github.com/JacobNWolf/biome-unnecessary-effect#readme",
  "bugs": {
    "url": "https://github.com/JacobNWolf/biome-unnecessary-effect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobNWolf/biome-unnecessary-effect.git"
  },
  "private": false,
  "scripts": {
    "test": "bun test",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "build:plugin": "sh scripts/build.sh",
    "prepublishOnly": "bun run build:plugin",
    "postinstall": "node scripts/postinstall.js"
  },
  "files": [
    "grit",
    "scripts/postinstall.js",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "biome-plugin"
  ],
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4"
  }
}
